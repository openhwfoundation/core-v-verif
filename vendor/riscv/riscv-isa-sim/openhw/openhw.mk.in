openhw_subproject_deps = \
	riscv \
	disasm \
	softfloat \

# Which core's openhw::Processor gets built into libopenhw.so. Overridable
# on the command line (e.g. `make OPENHW_CORE=cv32e20 install`) - this
# project's own sim/core/Makefile passes its existing CV_CORE_LC here, so
# the RTL core and the reference-model core stay in lock-step by default.
OPENHW_CORE ?= cv32e20

# common/, cv32e20/, and cva6/ are subdirectory-nested sources (unlike
# every other subproject in this build, which lists flat filenames) --
# -MMD writes each .d dependency file next to its .o, and none of these
# are auto-created by the generic compile rule, so they need to exist
# before the first compile runs (these are build-output dirs, relative to
# the out-of-tree build/ directory this is evaluated from).
$(shell mkdir -p common $(OPENHW_CORE) cva6)

# (Re)generate core_select.h into the *source* tree (not build/ - this is
# a header other subprojects #include via the always-present -I$(src_dir),
# same as any other openhw/ header), at Makefile-parse time, so it always
# reflects the current OPENHW_CORE value before any compile recipe runs -
# see reference/spike-implementation.md.
$(shell printf '// Generated by openhw.mk.in at build time - do not edit.\n#include "openhw/$(OPENHW_CORE)/Proc.h"\n' > $(src_dir)/openhw/core_select.h)

openhw_srcs = \
	common/Simulation.cc \
	common/riscv_dpi.cc \
	common/csrs_ext.cc \
	common/YamlParamSetter.cc \
	common/Params.cc \
	$(OPENHW_CORE)/Proc.cc \
	cva6/cva6_base.cc \
	cva6/cvxif_base.cc \
	cva6/cvxif.cc \
	cva6/cv32a60x.cc \

# The generic unit-test support expects a legacy libutst that is not part of
# this tree.  Build the CV32E20 reset regression as a normal (non-installed)
# program and add its output to the top-level `make check` inputs instead.
ifeq ($(OPENHW_CORE),cv32e20)
openhw_prog_srcs = cv32e20/reset_test.cc
openhw_reset_test_out = cv32e20/reset_test.out
test_outs += $(openhw_reset_test_out)

# Keep the test process's exit status (the generic %.out rule pipes through
# tee, which otherwise hides failures before check-cpp examines the log).
$(openhw_reset_test_out): cv32e20/reset_test
	./$< > $@ 2>&1; result=$$?; cat $@; exit $$result
endif

openhw_install_hdrs = \
	common/Simulation.h \
	common/csrs_ext.h \
	common/YamlParamSetter.h \
	common/Params.h \
	core_select.h \
	$(OPENHW_CORE)/Proc.h \
	cva6/cva6.h \
	cva6/cvxif.h \

openhw_install_shared_lib = yes
